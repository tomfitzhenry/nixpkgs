+
+				# CPU_FAN
+				register "FAN2.mode"            = "FAN_SMART_AUTOMATIC"
+				register "FAN2.smart.tmpin"     = "1"
+				register "FAN2.smart.tmp_off"   = "35"
+				register "FAN2.smart.tmp_start" = "40"
+				register "FAN2.smart.tmp_full"  = "88"
+				register "FAN2.smart.tmp_delta" = "2"
+				register "FAN2.smart.full_lmt"  = "1"
+				register "FAN2.smart.smoothing" = "1"
+				register "FAN2.smart.pwm_start" = "22"
+				register "FAN2.smart.slope"     = "3"
+
+				# SYS_FAN
+				register "FAN3.mode"            = "FAN_SMART_AUTOMATIC"
+				register "FAN3.smart.tmpin"     = "1"
+				register "FAN3.smart.tmp_off"   = "32"
+				register "FAN3.smart.tmp_start" = "38"
+				register "FAN3.smart.tmp_full"  = "86"
+				register "FAN3.smart.tmp_delta" = "2"
+				register "FAN3.smart.full_lmt"  = "1"
+				register "FAN3.smart.smoothing" = "1"
+				register "FAN3.smart.pwm_start" = "18"
+				register "FAN3.smart.slope"     = "3"
+				device pnp 2e.0 off end
+				device pnp 2e.1 on       # COM 1
+					io 0x60 = 0x3f8
+					irq 0x70 = 0x4
+					irq 0xf0 = 0x1
+				end
+				device pnp 2e.4 on       # Environment Controller
+                                        io 0x60 = 0x0a30
+                                        io 0x62 = 0x0a20
+                                        irq 0x70 = 0x00
+                                        irq 0x71 = 0x80
+				end
+				device pnp 2e.5 off end  # Keyboard
+				device pnp 2e.6 off end  # Mouse
+				device pnp 2e.7 off end  # GPIO
+				device pnp 2e.a off end  # CIR
+			end
+		end
+		device ref hda on end
+		device ref smbus on end
+	end
+end
