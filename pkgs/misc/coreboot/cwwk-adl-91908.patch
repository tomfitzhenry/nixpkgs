+++ b/src/mainboard/cwwk/adl/Kconfig.name
@@ -5,3 +5,10 @@ config BOARD_CWWK_CW_ADL_4L_V1
 
 config BOARD_CWWK_CW_ADLNTB_1C2L_V3
 	bool "CW-ADLNTB-1C2L-V3.0"
+
+config BOARD_CWWK_CW_ADLN_NAS_TWINLAKE
+	bool "CW-ADLN-NAS (Twin Lake)"
+	help
+	  CW-ADLN-NAS Twin Lake variant validated on N355 systems.
+	  N150 and other SKUs in the same chassis family are not covered
+	  by this board option until they are independently verified.
diff --git a/src/mainboard/cwwk/adl/bootblock.c b/src/mainboard/cwwk/adl/bootblock.c
index f19b383907..928cbb7192 100644
--- a/src/mainboard/cwwk/adl/bootblock.c
+++ b/src/mainboard/cwwk/adl/bootblock.c
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 
 #include <bootblock_common.h>
+#include <soc/gpio.h>
 #include <superio/ite/common/ite.h>
 #include <superio/ite/it8613e/it8613e.h>
 
@@ -8,5 +9,20 @@
 
 void bootblock_mainboard_early_init(void)
 {
+#if CONFIG(INTEL_LPSS_UART_FOR_CONSOLE)
+	/*
+	 * Route UART0 to the debug header in bootblock so early console is
+	 * available as soon as console_init() runs.
+	 */
+	static const struct pad_config early_uart_gpio_table[] = {
+		PAD_CFG_NF(GPP_H10, NONE, DEEP, NF2), /* UART0_RXD */
+		PAD_CFG_NF(GPP_H11, NONE, DEEP, NF2), /* UART0_TXD */
+	};
+
+	gpio_configure_pads(early_uart_gpio_table, ARRAY_SIZE(early_uart_gpio_table));
+#endif
+
+#if CONFIG(DRIVERS_UART_8250IO)
 	ite_enable_serial(UART_DEV, CONFIG_TTYS0_BASE);
+#endif
 }
