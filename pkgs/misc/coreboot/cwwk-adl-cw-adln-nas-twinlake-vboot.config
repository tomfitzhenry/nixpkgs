# Minimal coreboot defconfig for the CWWK CW-ADLN-NAS (Twin Lake) with vboot.
# The board Kconfig (selected below) pulls in the SOC_INTEL_TWINLAKE options,
# the public Intel FSP via FSP_USE_REPO, the IT8613E SuperIO and the vboot
# Kconfig block (which defaults FMDFILE to vboot-rwab.fmd). `make olddefconfig`
# fills in the rest.
CONFIG_VENDOR_CWWK=y
CONFIG_BOARD_CWWK_CW_ADLN_NAS_TWINLAKE=y
# Replaced by PAYLOAD_ELF/PAYLOAD_FILE (the EDK2 UEFI payload) via mkCoreboot.
CONFIG_PAYLOAD_NONE=y
