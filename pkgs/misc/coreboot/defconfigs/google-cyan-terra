# coreboot defconfig for the ASUS Chromebook C300SA (google/cyan, variant terra),
# as a non-ChromeOS "full ROM" with an EDK2 UEFI payload.
#
# The binary blobs (FSP, EC firmware, Intel flash descriptor, Intel ME) are not
# in coreboot's 3rdparty/blobs repo; they are injected via buildCoreboot's
# `files` argument from MrChromebox's blobs fork, which still carries them.
CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_TERRA=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/cyan/terra/flashdescriptor.bin"
CONFIG_HAVE_ME_BIN=y
CONFIG_ME_BIN_PATH="3rdparty/blobs/soc/intel/bsw/me.bin"
# HAVE_FSP_BIN is only auto-selected via FSP_USE_REPO, which google/cyan's
# USE_GOOGLE_FSP disables, so it must be set explicitly.
CONFIG_HAVE_FSP_BIN=y
CONFIG_FSP_FILE="3rdparty/blobs/mainboard/google/cyan/terra/fsp.bin"
CONFIG_EC_GOOGLE_CHROMEEC_FIRMWARE_EXTERNAL=y
CONFIG_EC_GOOGLE_CHROMEEC_FIRMWARE_FILE="3rdparty/blobs/mainboard/google/cyan/terra/ec.RW.flat"
CONFIG_SMMSTORE=y
CONFIG_SMMSTORE_V2=y
CONFIG_SMMSTORE_SIZE=0x80000
