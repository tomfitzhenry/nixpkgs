+		.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_UNUSED | PCIE_RP_BUILT_IN,
+		.pcie_rp_aspm = ASPM_L0S,
+	}"
+
+	register "ddi_ports_config" = "{
